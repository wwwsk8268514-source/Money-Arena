# Money Arena / Safaricom Daraja
# Copy this file to .env and fill in your own credentials.
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=https://YOUR-DOMAIN.example

# sandbox or production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=YOUR_STK_PASSKEY

# Used as the account/reference shown in the payment request
MPESA_ACCOUNT_NAME=MONEYARENA

# Optional: if you use a fixed PayBill/Till and want to display it
MPESA_DISPLAY_NAME=Money Arena

# Change this in production
SESSION_SECRET=CHANGE_THIS_SECRET

# For demo download gating only. In production use private object storage.
DOWNLOAD_BASE_URL=/downloads
